generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}
enum Visibility {
  PUBLIC
  SPACE_ONLY
  FOLLOWERS_ONLY
  PRIVATE
}
enum PostType {
  QUESTION
  DISCUSSION
  SHOWCASE
  TUTORIAL
  RESEARCH
  ANNOUNCEMENT
  POLL
}
enum ArtifactType {
  GUIDE
  ANSWER
  RESEARCH
  BENCHMARK
  CASE_STUDY
}
enum ArtifactStatus {
  DRAFT
  PUBLISHED
  COMMUNITY_REVIEWED
  VERIFIED
}
enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  displayName String
  bio String?
  avatarUrl String?
  avatarKey String?
  avatarMetadata Json?
  bannerKey String?
  bannerMetadata Json?
  headline String?
  location String?
  websiteUrl String?
  githubUrl String?
  linkedinUrl String?
  timezone String?
  expertise Json?
  skills Json?
  interests Json?
  links Json?
  passwordHash String?
  emailVerifiedAt DateTime?
  profileVisibility Visibility @default(PUBLIC)
  role UserRole @default(MEMBER)
  aiEnabled Boolean @default(true)
  suspendedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  spaces SpaceMember[]
  spaceFollows SpaceFollow[]
  posts Post[]
  replies Reply[]
  artifacts Artifact[]
  revisions ArtifactRevision[]
  artifactContributions ArtifactContributor[]
  artifactReports ArtifactReport[] @relation("ArtifactReporter")
  reports Report[] @relation("Reporter")
  moderationAppeals ModerationAppeal[] @relation("Appellant")
  reviewedAppeals ModerationAppeal[] @relation("Reviewer")
  auditEvents AuditEvent[]
  follows UserFollow[] @relation("Following")
  followers UserFollow[] @relation("Followers")
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  reactions PostReaction[]
  bookmarks Bookmark[]
  notifications Notification[]
  blocksGiven UserBlock[] @relation("BlocksGiven")
  blocksReceived UserBlock[] @relation("BlocksReceived")
  mutedSpaces SpaceMute[]
  aiOutputsRequested AiOutput[]
  aiFeedback AiFeedback[]
  oauthAccounts OAuthAccount[]
}

model Space {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String
  rules String?
  tags String[] @default([])
  isFeatured Boolean @default(false)
  isPublic Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members SpaceMember[]
  followers SpaceFollow[]
  posts Post[]
  artifacts Artifact[]
  mutedBy SpaceMute[]
}

model SpaceMember {
  userId String
  spaceId String
  isModerator Boolean @default(false)
  joinedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  @@id([userId, spaceId])
  @@index([spaceId, joinedAt])
}

model SpaceFollow {
  userId String
  spaceId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  @@id([userId, spaceId])
  @@index([spaceId, createdAt])
}

model Post {
  id String @id @default(cuid())
  authorId String
  spaceId String
  type PostType
  title String
  body String
  visibility Visibility @default(PUBLIC)
  isDeleted Boolean @default(false)
  isDraft Boolean @default(false)
  isPinned Boolean @default(false)
  pollOptions Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  replies Reply[]
  artifacts Artifact[]
  reports Report[]
  aiOutputs AiOutput[]
  reactions PostReaction[]
  bookmarks Bookmark[]
  @@index([spaceId, createdAt])
  @@index([spaceId, isPinned, createdAt])
  @@index([authorId, createdAt])
}

model Reply {
  id String @id @default(cuid())
  postId String
  authorId String
  parentId String?
  body String
  isAccepted Boolean @default(false)
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent Reply? @relation("ReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  children Reply[] @relation("ReplyThread")
  artifacts Artifact[]
  reports Report[]
  @@index([postId, createdAt])
}

model PostReaction {
  userId String
  postId String
  type String @default("LIKE")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
  @@index([postId, type])
}

model Bookmark {
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
  @@index([userId, createdAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  body String
  href String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker User @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
}

model SpaceMute {
  userId String
  spaceId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  @@id([userId, spaceId])
}

model Artifact {
  id String @id @default(cuid())
  authorId String
  spaceId String
  sourcePostId String?
  sourceReplyId String?
  type ArtifactType
  status ArtifactStatus @default(DRAFT)
  visibility Visibility @default(PUBLIC)
  title String
  summary String?
  body String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sourcePost Post? @relation(fields: [sourcePostId], references: [id], onDelete: SetNull)
  sourceReply Reply? @relation(fields: [sourceReplyId], references: [id], onDelete: SetNull)
  revisions ArtifactRevision[]
  contributors ArtifactContributor[]
  corrections ArtifactReport[]
  aiOutputs AiOutput[]
  sources Source[]
  @@index([spaceId, status, updatedAt])
}

model ArtifactRevision {
  id String @id @default(cuid())
  artifactId String
  editorId String
  title String
  body String
  revisionNumber Int
  changeSummary String?
  createdAt DateTime @default(now())
  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  editor User @relation(fields: [editorId], references: [id], onDelete: Cascade)
  @@unique([artifactId, revisionNumber])
}


model ArtifactContributor {
  artifactId String
  userId String
  role String @default("CONTRIBUTOR")
  createdAt DateTime @default(now())
  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([artifactId, userId])
  @@index([userId, createdAt])
}

model ArtifactReport {
  id String @id @default(cuid())
  artifactId String
  reporterId String
  reason String
  details String?
  status ReportStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  appeals ModerationAppeal[]
  reporter User @relation("ArtifactReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  @@index([artifactId, status, createdAt])
  @@index([reporterId, createdAt])
}
model Source {
  id String @id @default(cuid())
  artifactId String
  url String
  title String?
  citation String?
  addedAt DateTime @default(now())
  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  @@index([artifactId])
}

model Report {
  id String @id @default(cuid())
  reporterId String
  postId String?
  replyId String?
  reason String
  details String?
  status ReportStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  appeals ModerationAppeal[]
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  reply Reply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([replyId])
}

model AiOutput {
  id String @id @default(cuid())
  postId String?
  artifactId String?
  requestedById String?
  kind String
  provider String
  model String
  policyVersion String
  sourceIds Json?
  output Json
  status String
  createdAt DateTime @default(now())
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  artifact Artifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  requestedBy User? @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  feedback AiFeedback[]
  @@index([postId, kind])
  @@index([artifactId, kind])
  @@index([requestedById, createdAt])
}

model UserFollow {
  followerId String
  followingId String
  createdAt DateTime @default(now())
  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  @@id([followerId, followingId])
}


model AiFeedback {
  id String @id @default(cuid())
  aiOutputId String
  userId String
  type String
  details String?
  createdAt DateTime @default(now())
  aiOutput AiOutput @relation(fields: [aiOutputId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([aiOutputId, userId])
  @@index([userId, createdAt])
}
model ModerationAppeal {
  id String @id @default(cuid())
  appellantId String
  reportId String?
  artifactReportId String?
  reason String
  status String @default("OPEN")
  reviewerId String?
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appellant User @relation("Appellant", fields: [appellantId], references: [id], onDelete: Cascade)
  reviewer User? @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  artifactReport ArtifactReport? @relation(fields: [artifactReportId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([appellantId, createdAt])
}
model AuditEvent {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model AnalyticsEvent {
  id String @id @default(cuid())
  name String
  anonymousId String
  userId String?
  path String?
  properties Json?
  createdAt DateTime @default(now())
  @@index([name, createdAt])
  @@index([anonymousId, createdAt])
}

model PasswordResetToken {
  tokenHash String @id
  userId String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  tokenHash String @id
  userId String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model OAuthAccount {
  id String @id @default(cuid())
  userId String
  provider String
  providerAccountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}
